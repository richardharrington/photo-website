# Names only. Never commit real values: this repository may be public.
# Generate each path segment and key with fresh cryptographic randomness, e.g.
#   openssl rand -hex 16      (path segments)
#   openssl rand -base64 32   (ASSET_SIGNING_KEY)

# Opaque, independent, high-entropy URL path segments. Neither is derivable
# from the other. Single path segment each, with no "/".
DISPLAY_PATH=
ADMIN_PATH=

# Proves to a Netlify Function that a request arrived through the Edge Function
# gate. Netlify Functions are also addressable directly at
# /.netlify/functions/<name>; without this marker anyone could call the admin
# function and simply claim admin access mode. Any high-entropy random value.
INTERNAL_GATE_SECRET=

# Cloudflare R2, S3-compatible API.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_S3_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# HMAC key for signed asset URLs. The only secret shared between Netlify and
# the Cloudflare Worker. Set it in both places to the same value.
ASSET_SIGNING_KEY=

# Public base URL of the Cloudflare asset Worker, no trailing slash.
WORKER_BASE_URL=

# Viewer-facing site title.
SITE_TITLE=Family Photos

# Notifications. The recipient list is the Cloudflare account's destination
# address list, so the admin function needs a token that can read and write it:
# an API token with "Email Routing Addresses Write", restricted to this
# account. Secret. The account itself is R2_ACCOUNT_ID above, reused rather
# than named twice — the addresses live in the account that holds the bucket.
#
# The Worker gets a *separate, read-only* token under a *different* name
# (below). Each variable is named for the permission you tick when creating
# it, so the two cannot be swapped without the name looking wrong. Getting
# that backwards would not fail: the Worker would work perfectly, with the
# power to delete every recipient.
CLOUDFLARE_ADDRESSES_WRITE_TOKEN=

# The Cloudflare Worker has five secrets of its own, set with
# `wrangler secret put <NAME>` and never placed in wrangler.toml or here:
#
#   NOTIFY_FROM                  photos@<domain>, the digest's From address.
#                                Needs the domain's DNS hosted at Cloudflare,
#                                in this account, with Email Routing enabled.
#                                Any registrar; see the "Adding email
#                                notifications" section of docs/operations.md.
#   DISPLAY_SITE_URL             The display site's base URL including its
#                                secret path segment. The digest links to
#                                <this>/recent; write it with no trailing
#                                slash, though the Worker strips one.
#   CLOUDFLARE_ACCOUNT_ID        Same value as R2_ACCOUNT_ID.
#   CLOUDFLARE_ADDRESSES_READ_TOKEN
#                                A *read-only* token: "Email Routing Addresses
#                                Read". A different token and a different name
#                                from the write one above, so the cron can
#                                never alter the recipient list.
#   SITE_TITLE                   The same value as SITE_TITLE above. Not a
#                                secret; a Worker secret only so that one
#                                installation's name stays out of a repository
#                                anyone can fork. Set both or the mail and the
#                                website will disagree.
#
# ASSET_SIGNING_KEY is also set on the Worker; it signs the test-send grant as
# well as the asset URLs.
